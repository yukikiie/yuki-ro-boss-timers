{
  "name": "yuki-ro-boss-timers-github",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "build": "node scripts/build-frontend.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.js tests/*.test.mts",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc --ip 127.0.0.1 --port 8787",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "worker:migrate": "wrangler d1 migrations apply yuki-ro-boss-timers --remote --config worker/wrangler.jsonc"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "1.31.0",
    "web-push": "3.6.7",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "6.0.2",
    "@tailwindcss/postcss": "4.2.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  }
}
